# Public auth configuration (web)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Alternatively use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for a publishable key.

# Server-only configuration (web and optional Nest API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SERVICE_KEY
CONTACT_RATE_LIMIT_SECRET=YOUR_RANDOM_SECRET
# Enable only behind a proxy that replaces client IP headers.
TRUST_PROXY=false

# Optional Nest API
PORT=4000
CORS_ORIGINS=http://localhost:3000,https://safika-sultana-portfolio.vercel.app
